# Copy to .env.local for local development (never commit real values).

# Postgres connection. For the local database started by `npm run db:local`:
DATABASE_URL=postgres://postgres:postgres@localhost:54329/nium
# On AWS this is built at start-up from Secrets Manager (infra/aws/with-db.sh) and ends in ?sslmode=require.

# Optional: the public address, used by the CSRF check for browsers that don't send Sec-Fetch-Site.
# APP_ORIGIN=https://dxxxxxxxxxxxx.cloudfront.net
